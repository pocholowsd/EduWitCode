# En el servidor este archivo va como ~/EduWitCode/.env (junto a docker-compose.yml).
# Los valores son los mismos que el .env de bloques en el servidor: misma base y mismas cuentas.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=eduwit_go

JWT_SECRET=

DB_NETWORK=eduwit-go_internal

# En desarrollo no hace falta definir esto: Vite hace proxy de /api hacia
# el backend FastAPI incluido en backend/ (ver vite.config.js). Solo se usa
# en builds de produccion, donde el frontend se sirve por separado del backend.
# VITE_API_BASE_URL=http://localhost:8000
