CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ARDUINO_FQBN=arduino:avr:uno

# Cuentas y programas guardados: la misma base MySQL que el editor de bloques
# (eduwit_go), así las cuentas sirven en ambos. Sin DB_USER el editor funciona
# igual, pero sin iniciar sesión ni guardar en la nube.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=eduwit_go

# La sesión es la de la plataforma (eduwitlabs.com.mx/login). Por defecto la llave pública se descarga de
# https://eduwitlabs.com.mx/api/auth/llave-publica; en local, apúntala al backend central local.
# SESION_LLAVE_URL=http://localhost:8000/api/auth/llave-publica

# Cuentas administradoras (separadas por coma): pueden publicar, reemplazar y
# eliminar Ejemplos. Es la misma columna "rol" que usa el editor de bloques.
ADMIN_EMAILS=
